Package: MultiOmicsDataCompile
Type: Package
Title: Compile and Explore Multi-Omics Data
Version: 0.1.0
Authors@R: c(
    person("Brendan", "Gongol", email = "8220574+brendangongol@users.noreply.github.com",
           role = c("aut", "cre")),
    person("Xueyuan", "Jiang", role = "aut"),
